# OmniFlow Environment Configuration Template
# Copy this file to .env and replace placeholder values with your own.
# DO NOT commit real secrets or .env to version control.
#
# For a Render deployment (see README.md's "Deployment (Render)" section
# and render.yaml): APP_ENV/GEMINI_API_KEY/LOG_LEVEL are supplied as Render
# environment variables (dashboard or render.yaml), not this file -- it's
# local-development-only. PORT is supplied automatically by Render at
# runtime; do not set it manually there.

# Application Environment (development, staging, production)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Server Host and Port (HOST=0.0.0.0 and PORT are set for you in
# production -- see the Dockerfile/render.yaml; only relevant locally)
HOST=127.0.0.1
PORT=8000

# Gemini API Key (Required in future phases for LLM operations)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name
LLM_MODEL=gemini-2.5-flash

# Gemini Request Timeout (seconds)
GEMINI_TIMEOUT_SECONDS=30

# Maximum Upload Size in Megabytes
MAX_UPLOAD_SIZE_MB=25

# OCR Configuration
OCR_LANGUAGE=eng
TESSERACT_CMD=
PDF_NATIVE_TEXT_CHAR_THRESHOLD=30

# Speech-to-Text (faster-whisper) Configuration
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# YouTube Transcript Tool Configuration (Phase 3.2)
YOUTUBE_TRANSCRIPT_MAX_CHARS=200000

# Embedding Configuration (Phase 3 - sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# RAG Chunking and Retrieval Configuration (Phase 3)
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.2

# Bounded Agentic Execution (Phase 4.5)
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=6
MAX_RETRIES=2
