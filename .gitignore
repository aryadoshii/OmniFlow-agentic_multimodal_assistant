# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env*.local
*.key
*.pem
secrets/

# IDE & editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Testing & coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs
*.log
logs/

# Uploads and temporary artifact directories
uploads/
temp/
scratch/

# Local ML model weights / caches (sentence-transformers, HuggingFace, torch)
# These are downloaded on demand at runtime and must never be committed.
.cache/
.sentence_transformers_cache/
.hf_cache/
hf_cache/
models/
model_cache/
*.bin
*.safetensors
*.onnx
*.pt
*.pth

# The Python `lib/`/`lib64/` rule above is unanchored, so it also matches
# frontend/src/lib/ -- a real, required TypeScript source directory (API
# error/trace/id helpers imported by several components), not a Python
# venv's lib/. Un-ignore it and its contents explicitly; the directory
# itself must be negated in addition to its contents, or git will never
# descend into it to apply the second rule.
!frontend/src/lib/
!frontend/src/lib/**

# Local conversation history (SQLite) -- machine-local data, never committed.
omniflow_history.db
